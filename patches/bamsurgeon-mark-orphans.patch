@@ -242,6 +242,14 @@
                                     if args.requirepaired:
                                         logger.warning(mutid + " skipped mutation due to --requirepaired")
                                         return True, False, {}, {}, {}, {}
+                                    # Picard SamToFastq silently drops a record that is
+                                    # flagged paired when its mate record is absent. Mark
+                                    # this selected copy as a true orphan so it reaches the
+                                    # unpaired FASTQ and is not lost during realignment.
+                                    pread.alignment.flag &= ~(1 | 2 | 8 | 32 | 64 | 128)
+                                    pread.alignment.next_reference_id = -1
